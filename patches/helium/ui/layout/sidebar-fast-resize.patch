+
+bool BrowserView::IsVerticalTabStripWidthAnimating() const {
+  const auto* const controller = BrowserAnimationController::From(browser_);
+  if (!controller) {
+    return false;
+  }
+  const BrowserAnimationMotion motion =
+      controller->GetCurrentMotion(TabStripAnimations::kVerticalTabStrip);
+  return motion == TabStripAnimations::kExpand ||
+         motion == TabStripAnimations::kCollapse;
+}
+
+void BrowserView::OnVerticalTabStripAnimationUpdate(
+    const BrowserAnimationController* controller,
+    BrowserAnimationUpdate update) {
+  // kEnded and kCanceled are delivered before the controller clears its
+  // current motion, so treat them as "not animating" instead of querying
+  // GetCurrentMotion().
+  bool width_animating = false;
+  if (update == BrowserAnimationUpdate::kStarted ||
+      update == BrowserAnimationUpdate::kProgressed) {
+    const BrowserAnimationMotion motion =
+        controller->GetCurrentMotion(TabStripAnimations::kVerticalTabStrip);
+    width_animating = motion == TabStripAnimations::kExpand ||
+                      motion == TabStripAnimations::kCollapse;
+  }
+  SetSidebarAnimationFastResize(width_animating ||
+                                zen_side_attach_animation_.is_animating());
+}
+
+void BrowserView::SetSidebarAnimationFastResize(bool fast_resize) {
+  if (sidebar_animation_fast_resize_ == fast_resize) {
+    return;
+  }
+  sidebar_animation_fast_resize_ = fast_resize;
+  // Tab dragging manages the fast resize bit itself and re-lays out the
+  // contents when the drag ends.
+  if (browser_widget()->tab_drag_kind() != TabDragKind::kNone) {
+    return;
+  }
+  UpdateFastResizeForContentViews(fast_resize);
+  if (!fast_resize) {
+    // Make sure the contents get re-laid out even if their bounds didn't
+    // change, so the clip set up during fast resize is released (see
+    // ToolbarSizeChanged()).
+    for (auto* contents_web_view : GetAllVisibleContentsWebViews()) {
+      contents_web_view->InvalidateLayout();
+    }
+    contents_container_->DeprecatedLayoutImmediately();
+  }
 }
 

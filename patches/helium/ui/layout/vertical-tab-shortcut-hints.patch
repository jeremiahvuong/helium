+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_VERTICAL_TAB_SHORTCUT_HINT_OVERLAY_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_VERTICAL_TAB_SHORTCUT_HINT_OVERLAY_H_
+
+#include <memory>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/events/event_observer.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget_observer.h"
+
+class BaseTabStripRegionView;
+class TabStripModel;
+class TabStripView;
+
+namespace views {
+class EventMonitor;
+}  // namespace views
+
+// A paint-only overlay that shows tab switching shortcut hints ("⌘1".."⌘9")
+// next to each tab in the vertical tab strip while the tab switching modifier
+// (Command on macOS, Control elsewhere) is held down. The first eight tabs are
+// numbered 1-8, and the last tab shows 9 to match the "select last tab"
+// accelerator.
+class VerticalTabShortcutHintOverlay : public views::View,
+                                       public ui::EventObserver,
+                                       public views::WidgetObserver {
+  METADATA_HEADER(VerticalTabShortcutHintOverlay, views::View)
+ public:
+  VerticalTabShortcutHintOverlay(BaseTabStripRegionView* region_view,
+                                 TabStripModel* tab_strip_model);
+  VerticalTabShortcutHintOverlay(const VerticalTabShortcutHintOverlay&) =
+      delete;
+  VerticalTabShortcutHintOverlay& operator=(
+      const VerticalTabShortcutHintOverlay&) = delete;
+  ~VerticalTabShortcutHintOverlay() override;
+
+  // Called by the region view when the tab strip view is created or destroyed
+  // so the overlay can repaint when the tab containers scroll. `tab_strip_view`
+  // may be null.
+  void SetTabStripView(TabStripView* tab_strip_view);
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+  void AddedToWidget() override;
+  void RemovedFromWidget() override;
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override;
+
+  // views::WidgetObserver:
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override;
+
+ private:
+  void SetHintsShown(bool shown);
+  void PaintHint(gfx::Canvas* canvas, const gfx::Rect& tab_bounds, int number);
+
+  const raw_ptr<BaseTabStripRegionView> region_view_;
+  const raw_ptr<TabStripModel> tab_strip_model_;
+
+  bool hints_shown_ = false;
+
+  std::unique_ptr<views::EventMonitor> event_monitor_;
+  base::CallbackListSubscription pinned_scrolled_subscription_;
+  base::CallbackListSubscription unpinned_scrolled_subscription_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      widget_observation_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_VERTICAL_TAB_SHORTCUT_HINT_OVERLAY_H_

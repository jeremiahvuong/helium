+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/vertical/vertical_tab_shortcut_hint_overlay.h"
+
+#include <optional>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "build/build_config.h"
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/frame/base_tab_strip_region_view.h"
+#include "chrome/browser/ui/views/tabs/common/tab_strip_view.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_provider.h"
+#include "ui/compositor/layer.h"
+#include "ui/events/event.h"
+#include "ui/events/event_constants.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/font.h"
+#include "ui/gfx/font_list.h"
+#include "ui/gfx/geometry/rect_conversions.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/views/controls/scroll_view.h"
+#include "ui/views/event_monitor.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+// The modifier that triggers the hints, matching the platform's tab switching
+// accelerators (Cmd+1..9 on macOS, Ctrl+1..9 elsewhere).
+#if BUILDFLAG(IS_MAC)
+constexpr int kHintModifierFlag = ui::EF_COMMAND_DOWN;
+#else
+constexpr int kHintModifierFlag = ui::EF_CONTROL_DOWN;
+#endif
+
+constexpr int kChipHeight = 16;
+constexpr int kChipHorizontalPadding = 5;
+constexpr int kChipTrailingInset = 6;
+// Rounded close to, but not quite, a full pill.
+constexpr float kChipCornerRadius = kChipHeight / 2.0f - 2.0f;
+constexpr SkAlpha kChipOutlineAlpha = 0x2E;
+
+std::u16string GetHintText(int number) {
+#if BUILDFLAG(IS_MAC)
+  // U+2318 PLACE OF INTEREST SIGN (the Command key symbol).
+  return u"⌘" + base::NumberToString16(number);
+#else
+  return u"Ctrl+" + base::NumberToString16(number);
+#endif
+}
+
+}  // namespace
+
+VerticalTabShortcutHintOverlay::VerticalTabShortcutHintOverlay(
+    BaseTabStripRegionView* region_view,
+    TabStripModel* tab_strip_model)
+    : region_view_(region_view), tab_strip_model_(tab_strip_model) {
+  // The overlay is purely decorative and must never intercept events meant
+  // for the tabs underneath.
+  SetCanProcessEventsWithinSubtree(false);
+  // Paint to a layer so the hints render above the scrolling tab containers.
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+}
+
+VerticalTabShortcutHintOverlay::~VerticalTabShortcutHintOverlay() = default;
+
+void VerticalTabShortcutHintOverlay::SetTabStripView(
+    TabStripView* tab_strip_view) {
+  pinned_scrolled_subscription_ = {};
+  unpinned_scrolled_subscription_ = {};
+  if (!tab_strip_view) {
+    return;
+  }
+
+  // Repaint on scroll, since the overlay's layer is not damaged when the tab
+  // containers scroll underneath it.
+  auto repaint_if_shown = base::BindRepeating(
+      [](VerticalTabShortcutHintOverlay* overlay) {
+        if (overlay->hints_shown_) {
+          overlay->SchedulePaint();
+        }
+      },
+      base::Unretained(this));
+  pinned_scrolled_subscription_ =
+      tab_strip_view->pinned_tabs_scroll_view()->AddContentsScrolledCallback(
+          repaint_if_shown);
+  unpinned_scrolled_subscription_ =
+      tab_strip_view->unpinned_tabs_scroll_view()->AddContentsScrolledCallback(
+          repaint_if_shown);
+}
+
+void VerticalTabShortcutHintOverlay::OnPaint(gfx::Canvas* canvas) {
+  if (!hints_shown_) {
+    return;
+  }
+
+  const int tab_count = tab_strip_model_->count();
+  for (int i = 0; i < tab_count; ++i) {
+    // The first eight tabs get 1-8; 9 selects the last tab.
+    std::optional<int> number;
+    if (i < 8) {
+      number = i + 1;
+    }
+    if (i == tab_count - 1 && tab_count >= 9) {
+      number = 9;
+    }
+    if (!number.has_value()) {
+      continue;
+    }
+
+    views::View* const tab = region_view_->GetTabAnchorViewAt(i);
+    if (!tab || !tab->IsDrawn()) {
+      continue;
+    }
+
+    // Skip tabs that are (mostly) scrolled out of the viewport.
+    const gfx::Rect visible_bounds = tab->GetVisibleBounds();
+    if (visible_bounds.IsEmpty() ||
+        visible_bounds.height() < tab->height() / 2) {
+      continue;
+    }
+
+    gfx::RectF tab_bounds(tab->GetLocalBounds());
+    views::View::ConvertRectToTarget(tab, this, &tab_bounds);
+    PaintHint(canvas, gfx::ToEnclosingRect(tab_bounds), number.value());
+  }
+}
+
+void VerticalTabShortcutHintOverlay::AddedToWidget() {
+  views::Widget* const widget = GetWidget();
+  widget_observation_.Reset();
+  widget_observation_.Observe(widget);
+  event_monitor_ = views::EventMonitor::CreateWindowMonitor(
+      this, widget->GetNativeWindow(),
+      {ui::EventType::kKeyPressed, ui::EventType::kKeyReleased,
+       ui::EventType::kMouseReleased});
+}
+
+void VerticalTabShortcutHintOverlay::RemovedFromWidget() {
+  event_monitor_.reset();
+  widget_observation_.Reset();
+  SetHintsShown(false);
+}
+
+void VerticalTabShortcutHintOverlay::OnEvent(const ui::Event& event) {
+  const bool modifier_down = (event.flags() & kHintModifierFlag) != 0;
+  if (modifier_down && hints_shown_) {
+    // Tabs may have been added, closed or reordered while the modifier was
+    // held down; repaint with fresh positions.
+    SchedulePaint();
+  }
+  SetHintsShown(modifier_down);
+}
+
+void VerticalTabShortcutHintOverlay::OnWidgetActivationChanged(
+    views::Widget* widget,
+    bool active) {
+  // The modifier release is not observed when the window is deactivated while
+  // it is held down (e.g. Cmd+Tab), so hide the hints here.
+  if (!active) {
+    SetHintsShown(false);
+  }
+}
+
+void VerticalTabShortcutHintOverlay::SetHintsShown(bool shown) {
+  if (hints_shown_ == shown) {
+    return;
+  }
+  hints_shown_ = shown;
+  SchedulePaint();
+}
+
+void VerticalTabShortcutHintOverlay::PaintHint(gfx::Canvas* canvas,
+                                               const gfx::Rect& tab_bounds,
+                                               int number) {
+  const ui::ColorProvider* const color_provider = GetColorProvider();
+  if (!color_provider) {
+    return;
+  }
+
+  const std::u16string text = GetHintText(number);
+  const gfx::FontList font =
+      gfx::FontList().Derive(-1, gfx::Font::NORMAL, gfx::Font::Weight::MEDIUM);
+  const int chip_width =
+      gfx::Canvas::GetStringWidth(text, font) + 2 * kChipHorizontalPadding;
+
+  gfx::Rect chip_rect(tab_bounds.right() - kChipTrailingInset - chip_width,
+                      tab_bounds.CenterPoint().y() - kChipHeight / 2,
+                      chip_width, kChipHeight);
+  // Collapsed tabs can be narrower than the chip; center it instead.
+  if (chip_rect.x() < tab_bounds.x()) {
+    chip_rect.set_x(tab_bounds.x() + (tab_bounds.width() - chip_width) / 2);
+  }
+
+  // Tooltip colors keep the chip legible on top of both the light and dark
+  // theme tab strip.
+  const SkColor background =
+      color_provider->GetColor(ui::kColorTooltipBackground);
+  const SkColor foreground =
+      color_provider->GetColor(ui::kColorTooltipForeground);
+
+  cc::PaintFlags fill_flags;
+  fill_flags.setAntiAlias(true);
+  fill_flags.setStyle(cc::PaintFlags::kFill_Style);
+  fill_flags.setColor(background);
+  canvas->DrawRoundRect(gfx::RectF(chip_rect), kChipCornerRadius, fill_flags);
+
+  // Hairline outline for definition when the chip is close in color to what
+  // is underneath it.
+  cc::PaintFlags outline_flags;
+  outline_flags.setAntiAlias(true);
+  outline_flags.setStyle(cc::PaintFlags::kStroke_Style);
+  outline_flags.setStrokeWidth(1.0f);
+  outline_flags.setColor(SkColorSetA(foreground, kChipOutlineAlpha));
+  gfx::RectF outline_rect(chip_rect);
+  outline_rect.Inset(0.5f);
+  canvas->DrawRoundRect(outline_rect, kChipCornerRadius, outline_flags);
+
+  canvas->DrawStringRectWithFlags(text, font, foreground, chip_rect,
+                                  gfx::Canvas::TEXT_ALIGN_CENTER);
+}
+
+BEGIN_METADATA(VerticalTabShortcutHintOverlay)
+END_METADATA
